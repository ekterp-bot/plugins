# Copy to .env.store for STORE-001 local preview. Never commit populated values.
# These are server-only; never place secrets in browser/public files.
PORT=4176
SITE_ORIGIN=http://localhost:4176
SUPABASE_URL=https://pujpznngwcgutujqgmkp.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate a separate random secret. Keep it backed up: existing invitation
# verifiers depend on this value. Never rotate casually or reuse another key.
INVITE_CODE_PEPPER=

# Email-code delivery is configured in Supabase Auth SMTP, not this application.
# The following names are inactive historical support-adapter placeholders.
# api/support.js is deliberately disabled: setting these cannot enable sending.
# A future approved adapter needs shared abuse protection and verified sender DNS.
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=
SUPPORT_TO_EMAIL=

# Historical intake names only; the retired intake and disabled support handlers do not use them.
# Do not activate the legacy handler as the plugin-support endpoint.
INTAKE_FROM_EMAIL=
INTAKE_TO_EMAIL=
